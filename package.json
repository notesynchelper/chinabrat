{
  "name": "chinabrat",
  "version": "1.0.1",
  "description": "Install Obsidian plugins from a directory URL.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "build": "npm run check && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "check": "tsc --noEmit --skipLibCheck",
    "lint": "eslint src manifest.json package.json --max-warnings=0"
  },
  "license": "MIT",
  "devDependencies": {
    "@typescript-eslint/parser": "^8.67.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "^1.13.1",
    "typescript": "^5.6.3"
  }
}
